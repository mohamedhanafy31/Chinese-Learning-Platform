{$APP_DOMAIN} {
	# Local video upload is development-only. Production API uploads are limited
	# to the image-sized request bodies used by later milestones.
	handle /api/* {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:4000
	}

	handle_path /media/* {
		root * /srv/uploads/images
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
