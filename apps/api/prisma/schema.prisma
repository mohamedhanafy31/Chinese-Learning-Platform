generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String
  name           String
  phone          String
  role           Role            @default(STUDENT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  passwordResets PasswordReset[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  replacedById     String?   @unique @db.Uuid
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       Session?  @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         Session?  @relation("SessionReplacement")

  @@index([familyId])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MediaKind {
  IMAGE
}

model MediaAsset {
  id               String    @id @default(uuid()) @db.Uuid
  kind             MediaKind
  storageKey       String    @unique
  mime             String
  sizeBytes        Int
  width            Int
  height           Int
  checksum         String    @unique
  createdAt        DateTime  @default(now())
  levelCovers      Level[]
  lessonThumbnails Lesson[]
}

model Level {
  id               String      @id @default(uuid()) @db.Uuid
  slug             String      @unique
  hanzi            String
  title            Json
  summary          Json
  topics           Json
  priceMinor       Int?
  currency         String      @default("EGP")
  sortOrder        Int
  isPublished      Boolean     @default(false)
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  coverImageId     String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  coverImage       MediaAsset? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  lessons          Lesson[]

  @@unique([sortOrder])
  @@index([isPublished, archivedAt, sortOrder])
}

model Lesson {
  id               String      @id @default(uuid()) @db.Uuid
  levelId          String      @db.Uuid
  title            Json
  description      Json?
  hanzi            String?
  sortOrder        Int
  isPublished      Boolean     @default(false)
  isFreePreview    Boolean     @default(false)
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  thumbnailId      String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  level            Level       @relation(fields: [levelId], references: [id], onDelete: Restrict)
  thumbnail        MediaAsset? @relation(fields: [thumbnailId], references: [id], onDelete: SetNull)

  @@unique([levelId, sortOrder])
  @@index([levelId, isPublished, archivedAt, sortOrder])
}
