generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  email              String           @unique
  passwordHash       String
  name               String
  phone              String
  role               Role             @default(STUDENT)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  passwordResets     PasswordReset[]
  enrollments        Enrollment[]     @relation("EnrollmentStudent")
  grantedEnrollments Enrollment[]     @relation("EnrollmentGrantedBy")
  revokedEnrollments Enrollment[]     @relation("EnrollmentRevokedBy")
  quizAttempts       QuizAttempt[]
  orders             Order[]
  lessonProgress     LessonProgress[]
  auditLogs          AuditLog[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  replacedById     String?   @unique @db.Uuid
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       Session?  @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         Session?  @relation("SessionReplacement")

  @@index([familyId])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum MediaKind {
  IMAGE
}

model MediaAsset {
  id               String     @id @default(uuid()) @db.Uuid
  kind             MediaKind
  storageKey       String     @unique
  mime             String
  sizeBytes        Int
  width            Int
  height           Int
  checksum         String     @unique
  createdAt        DateTime   @default(now())
  levelCovers      Level[]
  lessonThumbnails Lesson[]
  questionImages   Question[]
}

model Level {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique
  hanzi            String
  title            Json
  summary          Json
  topics           Json
  priceMinor       Int?
  currency         String       @default("EGP")
  sortOrder        Int
  isPublished      Boolean      @default(false)
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  coverImageId     String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  coverImage       MediaAsset?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  lessons          Lesson[]
  enrollments      Enrollment[]
  orders           Order[]

  @@unique([sortOrder])
  @@index([isPublished, archivedAt, sortOrder])
}

model Lesson {
  id               String           @id @default(uuid()) @db.Uuid
  levelId          String           @db.Uuid
  title            Json
  description      Json?
  hanzi            String?
  sortOrder        Int
  isPublished      Boolean          @default(false)
  isFreePreview    Boolean          @default(false)
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  thumbnailId      String?          @db.Uuid
  activeVideoId    String?          @unique @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  level            Level            @relation(fields: [levelId], references: [id], onDelete: Restrict)
  thumbnail        MediaAsset?      @relation(fields: [thumbnailId], references: [id], onDelete: SetNull)
  activeVideo      VideoAsset?      @relation("ActiveVideo", fields: [activeVideoId], references: [id], onDelete: NoAction)
  videos           VideoAsset[]     @relation("LessonVideos")
  quizzes          Quiz[]
  progress         LessonProgress[]

  @@unique([levelId, sortOrder])
  @@index([levelId, isPublished, archivedAt, sortOrder])
}

enum VideoProvider {
  LOCAL
  BUNNY
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model VideoAsset {
  id             String        @id @default(uuid()) @db.Uuid
  lessonId       String        @db.Uuid
  provider       VideoProvider
  status         VideoStatus
  localKey       String?       @unique
  mime           String?
  durationSec    Int?
  sizeBytes      BigInt?
  originalName   String        @db.VarChar(255)
  bunnyLibraryId String?
  bunnyVideoId   String?       @unique
  lastEventAt    DateTime?
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lesson         Lesson        @relation("LessonVideos", fields: [lessonId], references: [id], onDelete: Cascade)
  activeFor      Lesson?       @relation("ActiveVideo")

  @@index([lessonId])
}

model PendingVideoDelete {
  id             String   @id @default(uuid()) @db.Uuid
  bunnyVideoId   String   @unique
  bunnyLibraryId String?
  attempts       Int      @default(0)
  lastError      String?  @db.VarChar(500)
  nextAttemptAt  DateTime
  createdAt      DateTime @default(now())

  @@index([nextAttemptAt])
}

enum WebhookProvider {
  BUNNY
  PAYMOB
}

/// One processed provider webhook; the unique key makes redelivery a no-op.
model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        WebhookProvider
  externalEventId String
  receivedAt      DateTime        @default(now())

  @@unique([provider, externalEventId])
}

enum EnrollmentSource {
  PURCHASE
  ADMIN
}

model Enrollment {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  levelId      String           @db.Uuid
  source       EnrollmentSource
  grantedById  String?          @db.Uuid
  revokedAt    DateTime?
  revokedById  String?          @db.Uuid
  revokeReason String?          @db.VarChar(500)
  orderId      String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("EnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  level        Level            @relation(fields: [levelId], references: [id], onDelete: Restrict)
  grantedBy    User?            @relation("EnrollmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy    User?            @relation("EnrollmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, levelId])
  @@index([levelId])
  @@index([orderId])
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  REFUNDED
}

model Order {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  levelId           String               @db.Uuid
  amountMinor       Int
  currency          String               @default("EGP")
  status            OrderStatus          @default(PENDING)
  specialReference  String               @unique
  paymobIntentionId String?              @unique
  paymobOrderId     String?              @unique
  clientSecret      String?
  checkoutUrl       String?
  expiresAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  level             Level                @relation(fields: [levelId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]
  enrollments       Enrollment[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([userId, levelId, status])
}

model PaymentTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  orderId               String   @db.Uuid
  providerTransactionId String   @unique
  integrationId         String
  success               Boolean
  pending               Boolean
  isRefund              Boolean
  isVoided              Boolean
  amountMinor           Int
  currency              String
  payloadRedacted       Json
  occurredAt            DateTime
  createdAt             DateTime @default(now())
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

model Quiz {
  id           String        @id @default(uuid()) @db.Uuid
  lessonId     String        @db.Uuid
  title        Json
  description  Json?
  passingScore Int           @default(70)
  sortOrder    Int
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questions    Question[]
  attempts     QuizAttempt[]

  @@unique([lessonId, sortOrder])
  @@index([lessonId, archivedAt, sortOrder])
}

model Question {
  id          String       @id @default(uuid()) @db.Uuid
  quizId      String       @db.Uuid
  type        QuestionType
  prompt      Json
  hanzi       String?      @db.VarChar(200)
  imageId     String?      @db.Uuid
  explanation Json?
  points      Int          @default(1)
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  image       MediaAsset?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  options     Option[]

  @@unique([quizId, sortOrder])
}

model Option {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  text       Json
  isCorrect  Boolean
  sortOrder  Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
}

/// One graded submission. `snapshot` freezes the questions as they were when
/// the learner answered, so later quiz edits never rewrite history.
model QuizAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  quizId       String   @db.Uuid
  score        Int
  earnedPoints Int
  totalPoints  Int
  passed       Boolean
  snapshot     Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Restrict)

  @@index([userId, quizId, createdAt])
}

/// One learner's watch coverage and completion of one lesson. `completedAt` is
/// sticky: once set it is never cleared, even if a quiz is added later. The
/// lesson FK cascades so progress goes with a lesson when an administrator
/// permanently deletes it; the user FK restricts.
model LessonProgress {
  userId           String    @db.Uuid
  lessonId         String    @db.Uuid
  /// Merged, sorted `[from, to]` second ranges actually watched (<= 200).
  watchedSegments  Json      @default("[]")
  watchedSec       Int       @default(0)
  durationSec      Int?
  lastPositionSec  Int       @default(0)
  videoCompletedAt DateTime?
  completedAt      DateTime?
  lastReportAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, completedAt])
  @@index([lessonId])
}

/// Append-only record of one admin mutation. Rows are never updated or
/// deleted; `data` holds ids and non-secret changed fields only.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  entity    String
  entityId  String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}
