# Runtime
NODE_ENV=development
PORT=4000
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000

# PostgreSQL (development Compose database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Integration tests default to the isolated Compose database on port 5433.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/app_test?schema=public
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT (replace these local-only placeholders with long random production secrets)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Bunny Stream (optional until the media milestones; all values are required to enable Bunny)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
BUNNY_WEBHOOK_SECRET=
BUNNY_CDN_HOST=

# Paymob (optional until the billing milestones)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# SMTP (optional; set every SMTP_* value to enable delivery)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
