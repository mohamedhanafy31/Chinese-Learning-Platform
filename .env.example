# Runtime
NODE_ENV=development
PORT=4000
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000
# Image uploads. Defaults to ./uploads under the API working directory
# (apps/api/uploads in development). Production Compose sets /app/uploads.
UPLOADS_DIR=
# Largest local (development-only) video upload in bytes. Defaults to 2 GiB.
VIDEO_MAX_BYTES=
# Where the browser posts large video uploads in development, bypassing the
# Next dev server's /api proxy (the API allows CORS from APP_URL for that one
# route). Ignored in production, where the same-origin /api path is used.
API_PUBLIC_ORIGIN=http://localhost:4000

# PostgreSQL (development Compose database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public
# Integration tests default to the isolated Compose database on port 5433.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/app_test?schema=public
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT (local-only placeholders: production must use long random secrets, see the Production block below)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Bunny Stream (optional until the media milestones; all values are required to enable Bunny)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
# The library's Read-Only API key: Bunny signs webhooks with it.
BUNNY_WEBHOOK_SECRET=
BUNNY_CDN_HOST=
# Optional overrides (defaults shown). Tests point these at a mock Bunny server.
# BUNNY_API_BASE=https://video.bunnycdn.com
# BUNNY_EMBED_BASE=https://iframe.mediadelivery.net
# Seconds a signed embed link stays valid (default 7200).
# BUNNY_EMBED_TTL_SEC=7200
# Seconds between Bunny reconcile runs; 0 disables them (default 300).
# VIDEO_RECONCILE_INTERVAL_SEC=300

# Paymob (optional until the billing milestones)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
# Optional overrides (defaults shown). Tests point the API base at a mock server.
# PAYMOB_API_BASE=https://accept.paymob.com
# PAYMOB_CHECKOUT_BASE=https://accept.paymob.com/unifiedcheckout/
# Order lifetime in minutes (default 60).
# ORDER_TTL_MIN=60
# Seconds between pending-order expiry runs; 0 disables them (default 300).
# BILLING_EXPIRY_INTERVAL_SEC=300

# SMTP (optional; set every SMTP_* value to enable delivery)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# =============================================================================
# PRODUCTION (docker compose on the VPS) - see infra/DEPLOY.md
# =============================================================================
# Everything above is the local development default. On the server, create .env
# by copying this file and REPLACING the development values above with the ones
# below (uncomment and fill in). Compose refuses to start when a required value
# is missing, and the API refuses to boot on weak or placeholder secrets.
#
# Generate secrets with:   openssl rand -base64 48     (JWT secrets)
#                          openssl rand -hex 24        (Postgres password: no
#                                                       characters that break a URL)
#
# --- Required ---------------------------------------------------------------
# NODE_ENV=production                  (Compose also forces it for api and web)
# APP_DOMAIN=school.example.com        public hostname Caddy serves
# APP_URL=https://school.example.com   https, no trailing slash; also the allowed
#                                      Origin for state-changing requests
# POSTGRES_DB=app
# POSTGRES_USER=app
# POSTGRES_PASSWORD=<openssl rand -hex 24>
# JWT_ACCESS_SECRET=<openssl rand -base64 48>
# JWT_REFRESH_SECRET=<a different openssl rand -base64 48>
#
# DATABASE_URL and INTERNAL_API_URL are set by docker-compose.yml; leave them out.
# Paymob / Bunny / SMTP groups above are all-or-nothing in production.
# API_PUBLIC_ORIGIN (development only, above) must be removed or left empty: in
# production the Paymob webhook URL is derived from APP_URL.
#
# --- Optional: host ports (the local smoke uses 18080/18443) -----------------
# HTTP_PORT=80
# HTTPS_PORT=443
#
# --- Optional: backups (infra/backup, see DEPLOY.md "Backups and restore") ---
# BACKUP_DIR=/var/backups/chinese-platform  host folder; must be owned by BACKUP_UID
# BACKUP_UID=1000                           uid/gid that owns the backup files
# BACKUP_GID=1000
# BACKUP_TIME=03:30                         daily, 24 h clock
# BACKUP_TZ=Africa/Cairo
# BACKUP_RETENTION_DAYS=14
#
# --- Optional: resource limits (defaults suit 2 vCPU / 8 GB; table in DEPLOY.md)
# CADDY_MEM_LIMIT=128m    CADDY_CPUS=0.5   CADDY_PIDS_LIMIT=128
# WEB_MEM_LIMIT=1g        WEB_CPUS=1.0     WEB_PIDS_LIMIT=256
# API_MEM_LIMIT=768m      API_CPUS=1.0     API_PIDS_LIMIT=256
# MIGRATE_MEM_LIMIT=512m  MIGRATE_CPUS=1.0 MIGRATE_PIDS_LIMIT=128
# POSTGRES_MEM_LIMIT=1g   POSTGRES_CPUS=1.5 POSTGRES_PIDS_LIMIT=200
# BACKUP_MEM_LIMIT=256m   BACKUP_CPUS=0.5  BACKUP_PIDS_LIMIT=64
# POSTGRES_SHARED_BUFFERS=256MB  POSTGRES_EFFECTIVE_CACHE_SIZE=640MB
# POSTGRES_WORK_MEM=4MB  POSTGRES_MAINTENANCE_WORK_MEM=64MB  POSTGRES_MAX_CONNECTIONS=50
